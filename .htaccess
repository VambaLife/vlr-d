Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ServerSignature Off
LimitRequestBody 65536

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
    RewriteRule ^ https://vlr-dmitrov.ru%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^properties\.html$ /properties/ [R=301,L]
    RewriteRule ^properties$ /properties/ [R=301,L]
    RewriteRule ^(?:app|config|logs|storage|backup|src|scripts|tests|node_modules|vendor)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?!api/).*\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "(?:^\.|\.(?:env|ini|log|sqlite|sqlite-wal|sqlite-shm|md|json|conf|sh|yml|yaml|bak|sql)$)">
    Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+w89k4G6ZB47m/IHChxVQGDIWPvozbgmPDL77HnUIQ4=' 'sha256-+zifc+8oGQkijYebIYTkAIbQzVkItz/hCvonMfkKvWQ=' 'sha256-/ZhpNRNScunu9hEhuQMdUHVM3YodCyyzazQDO4hOv4Y=' 'sha256-0r0YdzpTSaRRB3r8EKjNhxHGnGP4xCHkmklI2Fud5rg=' 'sha256-1tHPt7JbL+Jif2SiLFsQgEyYVD5ksSmD22CCpSaoVN8=' 'sha256-2G7nZmqHYTlM6swN3lsJA5AWjVFC2WbVa/Km/kErUBQ=' 'sha256-5LFjtrxbB/hx7y9cARAbLRiVWNxoRvIiQW17c/q8zL4=' 'sha256-6HaqU1Ut2q1lsvD7PGM1n5ULDqyYnmPNCoG2cIblG0A=' 'sha256-6gMNTGcGzENp5OKw2fE9xCdC7GD7RGjOuHzMJ5HE/nU=' 'sha256-E7A52GeY3VV2TuWsYmMifCgPu3HQ0JtAk50oGWjDseM=' 'sha256-GoUJhIepS+/fAi1Xrx1lXrYRchTI9EPSWz/Y1i5Yzs4=' 'sha256-H77awIvNd8Y5DKg8TmFHkbrKiRbSrMCVh5BK/kPjt04=' 'sha256-MK9VmredSMQz/ueAr2zmHCI98/MXD1SEWTL/UTJBMos=' 'sha256-P1aRGBSZ1kA9i/YI+1fLGoX8+HAeEaw48VHtq4ligIM=' 'sha256-VjjFxhQjYztFhTZPLu2fs06QtW9Y5U6XazQ5gZVhiEg=' 'sha256-Y8O+ORbBGUPxbg9oEMopnOGCuqC9hsYLVg7Lw9wj61Q=' 'sha256-hklM7yNXhMNd9FczfYaQ4k1+BZB4uUxRU5p23Q/ae60=' 'sha256-jm9Tt8E7mrbrQaXApODUaOGXiI9hIEsQX1QewzhZmu4=' 'sha256-qgTJJBfBc39W/zssgt+VLpCkKldUSaudbfXkYfTmGOQ=' 'sha256-uJf4BxFWUqxTuQKU8e24zbNeWFtLqWqb4w5Ok3/vtxU=' 'sha256-wR9l0k+wK78F+F4g058bzYkZnRFRXgCaL6ChSXfJ3SM=' 'sha256-x7sG52XGZ1uxd4DR6RWwsgiixbFaRFAeFM2EgcSjgus=' 'sha256-yJC5UTOBwByfwtdjeDcGdzoXLfyNJio2F0toUUscyls=' 'sha256-yPe/jByySmstxyeTIcqnCMUxDF+5PBA92pWlScABXTQ=' 'sha256-ygpIMSF83EKnrDz6cOn64kanj2AAopDt4bpPwCYsik4='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 minutes"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
