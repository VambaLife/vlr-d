Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ServerSignature Off
LimitRequestBody 65536

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
    RewriteRule ^ https://vlr-dmitrov.ru%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^properties\.html$ /properties/ [R=301,L]
    RewriteRule ^properties$ /properties/ [R=301,L]
    RewriteRule ^(?:app|config|logs|storage|backup|src|scripts|tests|node_modules|vendor)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?!api/).*\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "(?:^\.|\.(?:env|ini|log|sqlite|sqlite-wal|sqlite-shm|md|json|conf|sh|yml|yaml|bak|sql)$)">
    Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-+6CdeFhDRjNlbmNJ+L98ZHgeg7EEPOy+fdxtW+GCxJA=' 'sha256-7yvPKb9vGXBGk8L7WWIPah3zo06mckl5hpkNKv0SvEo=' 'sha256-90BLhDGq1vl/jG4noFG/8v1VeLkLga4M5GDNO+lnTj8=' 'sha256-J/n3ok+MrFptzGpDoULtBYFWdqJGpW36C2l55JrZ53A=' 'sha256-KsKPLEECCl200Xg2UlddwgN3lY4B12dfnCi5/Y7Otwk=' 'sha256-QmsrgJoLaYmpyYK5CFbcwdetDhISHYI19Cn1812Leas=' 'sha256-RAwT1FZ2VNSjW7Ej+USEt+gLI70csS2mMcflCyoZWMg=' 'sha256-US7vmRQgcrkg0R2pNcAb/1fn5kos30LarQ1oG2QOIdQ=' 'sha256-Z5MqXOge/nWm9sNLwA4MyYnJmyenqpi0o3q4htw0tZk=' 'sha256-btXvRwykuB1FFjt1/wxE1Q3h1P+bsHn4lWzr3vm7vc4=' 'sha256-eIKtGTXhFcyslnufYRZExd3T1F9y3oPpeNvAk8alplg=' 'sha256-eswoWFXrovrOmQMWn41+0gVyp3V5Ch5tMVOeMkEkZ3A=' 'sha256-iJQYA7RmX9de6y8v40fLm7COGN4qBx7lHbScOdwVFUM=' 'sha256-k+drUWv3BKnIO3g8mNIJ6sZ/M4ll7DFggLXU1Yl8KZE=' 'sha256-mE55PGjbWDkJnvwazVqnhUDNGmDcIaXsvS+hOQ2b5gQ=' 'sha256-nZgc5YiheD58H/0bREumQQ5dKLi1WX4485cI60dK0No=' 'sha256-oY9qIj+LIt2y30/vVEY8wwF+bh2iRPnL6qGOfTptlF8=' 'sha256-pjCHuq/ylKp8hHio+jHGqXU2ZAvTNvlY0jBKUxQdlZA=' 'sha256-rudw5QKDzr2IvF+mlq/LDQd67I/5Jimps87f3HFZ0nU=' 'sha256-uXgA0ZEtpK8dZ7Te/G3ZNzoRDFwsBBRI70rdOz3TMCQ=' 'sha256-uhi596ngplSzhg0ZrDehR4xZVgSsZnYKxWJowbCa9dg=' 'sha256-vPJ0d8wtVKmtrDcANdEnPBxX0k41WXne9OXzEgKeQEA=' 'sha256-vUfgK8MjT+F4sm3F0KCtVFYHTsp3WBsqRQfe63+e5P4=' 'sha256-va4hrvOlb/WCndkjLBzLs0i+WyVH9W/8yu/1IQPdyg0='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 minutes"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
