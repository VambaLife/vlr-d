Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset UTF-8
ServerSignature Off
LimitRequestBody 65536

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
    RewriteRule ^ https://vlr-dmitrov.pages.dev%{REQUEST_URI} [R=301,L,NE]

    RewriteRule ^properties\.html$ /properties/ [R=301,L]
    RewriteRule ^properties$ /properties/ [R=301,L]
    RewriteRule ^(?:app|config|logs|storage|backup|src|scripts|tests|node_modules|vendor)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L,NC]
    RewriteRule ^(?!api/).*\.php$ - [F,L,NC]
</IfModule>

<FilesMatch "(?:^\.|\.(?:env|ini|log|sqlite|sqlite-wal|sqlite-shm|md|json|conf|sh|yml|yaml|bak|sql)$)">
    Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

<IfModule mod_mime.c>
    AddType image/avif .avif
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-2dh0z6MK7f9nwvYLkOmnFvhBRExpMDEePyv/XNbTV/A=' 'sha256-3Z69tP6g70jZ5JsmyRUnVeUYpVKq0VX0o54/pFfAjys=' 'sha256-4yKIxZbT4k61y1wT1rsD+tBRt6RfetyY3HGO0HPqVWk=' 'sha256-54BZJWp26IZe3vgIaDG20HPoO+SBB8An1X69rdaBvEk=' 'sha256-54IcZWqz0pSdC+Mj8tEwd6XZw+LyQpHt9NNfwCa5b0E=' 'sha256-6M33m57c9ci4f9JO3gjYgk83p3uc+yqkA/LEeyWoMNQ=' 'sha256-6m+BecuqP0XieACi4ZrbitpZid1NfIWp4hMMlEIYa2o=' 'sha256-AXqgQ7XbdRDppLKiaKW+IZNmLXJMa5sEmyNFcb92xhw=' 'sha256-B5RIzph4oo/yAIhutweMmGB1rl/UbT44nlAAuJBoNfw=' 'sha256-BmAkePzHU2CMgLdDUnKO87OkGLInDpQpfmIdmvDJMRE=' 'sha256-H3VnHRfGgAqOybFXaMIWLLR9xbEbgB9Y0fg2fP6MKy0=' 'sha256-JrgCGysNybNsogth04+RI2fvxpobvBCXi/kUL8jGV+0=' 'sha256-NO+V1J/zvD3il5IxE8NikYWYoRU6esWD8MWyfiYb9bk=' 'sha256-P1noaJrc1NtqS0REkaPIDysNm04DQNE9BOLqACRqAzI=' 'sha256-TMgIhEqOwTlI4BFVfGn9XaT/ouQieUhLBV+5Yv81MFA=' 'sha256-ThkG+hzlgZrnObJaI5M9htGgsrc9KRQ+1EFcKAazwP8=' 'sha256-TtbzLeTwfMdpgLKV2g6qrEpVkYa6kjbPJYNDuPPZOVk=' 'sha256-VifsUDpf4Dpeo7SmLK4u7aAogt5fr1Z5kuIIVWW4cKk=' 'sha256-e93c8Tt5D+HpZ9DHbDUAOXCmYWNsDpQZjuuCWsATymU=' 'sha256-fZJO9akujZN1hk9V0B0lJlBKLIsHuYK08tL2pLOHI7g=' 'sha256-hhkdTvamCmJ0vypLXs+Dr1E3DE9OIPK89thN/2kBUQk=' 'sha256-iNK5Ta0zR3tAGt3f8Exo1XSlcVX7T+g9pC6rwdQ98Tw=' 'sha256-oWZi/Z5jTzoo2MT7nmZbj82UoAZV28u7B/iXnApMJx0=' 'sha256-woEqmU6amgjokItbVFReovcT0qrTSex0O5XK+lH2xMw=' 'sha256-wy1jH9FfjEN38Q1F6SzMHuiPLEleLqJzMziiNdIEku0='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 minutes"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
